# Copia este archivo como .env y NUNCA lo subas al repo (agrégalo a .gitignore)
GASTOCLARO_SECRET_KEY=cambia-esto-por-una-cadena-aleatoria-larga
DATABASE_URL=sqlite:///./gastoclaro.db
CORS_ORIGINS=http://localhost:5173
ENV=dev
# opcional: pega tu DSN de Sentry (sentry.io, plan free) para ver los
# errores de producción sin entrar a revisar logs a mano
SENTRY_DSN=
